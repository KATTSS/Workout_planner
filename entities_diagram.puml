@startuml BaseEntities

class Exercise {
    + id: int
    + name: String 
    + level: int 
    + description: String  
    + muscle: String 
    + secondaryMuscle: String 
    __
    + Exercise(id, name, level, description?, muscle?, secondaryMuscle?)
    + Exercise.basic(id, name, level) 
    + Exercise.descripted(id, name, level, description) 
    + Exercise.full(id, name, level, description, muscle, secondaryMuscle) 
    + toString(): String 
}

class DurationableExercise extends Exercise {
    + duration: double 
    __
    + DurationableExercise(id, name, level, duration)
}

class RepeatableExercise extends Exercise {
    + reps: int 
    + rounds: int 
    __
    + RepeatableExercise(id, name, level, reps, rounds) 
}

interface Equipmentable <<mixin>> {
    + equipment: Equipment 
}

class RepeatableEquipmentableExercise extends RepeatableExercise implements Equipmentable {
    __
    + RepeatableEquipmentableExercise(id, name, level, reps, rounds, equipment)
}

class DurationableEquipmentableExercise extends DurationableExercise implements Equipmentable {
    __
    + DurationableEquipmentableExercise(id, name, level, duration, equipment)
}

class Weight {
    - Mass 
    __
    + GetMass()
}

class Machine {
}

class Equipment {
    + Name
}

Equipment <|-- Machine
Equipment <|-- Weight

@enduml